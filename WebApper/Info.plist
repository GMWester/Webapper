	<string>Web apps can use the camera when you allow it.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Web apps can use the microphone when you allow it.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Web apps can use your location when you allow it.</string>
